# Generated by hack/tier2/site.yml for {{ cluster_name }}.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ cp_ipv4 }}:6443"
    token: "{{ join_token }}"
    caCertHashes:
    - "{{ join_ca_hash }}"
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  taints: []
  kubeletExtraArgs:
  - name: node-ip
    value: "{{ node_ipv4 }},{{ node_ipv6 }}"
